{
  "description": "Fixtures for the contract test. Each case names the documents to validate together and the exact set of problem codes the test must report for them - no more and no fewer, so a case whose 'expect' is empty is a document that must pass every check. Document paths are relative to the repository root, so a case can pair a broken fixture with a good example. See tests/README.md.",
  "cases": [
    {
      "name": "malformed JSON",
      "expect": ["json/parse-error"],
      "documents": { "analysis": "tests/fixtures/invalid/analysis-malformed.json" }
    },
    {
      "name": "document does not exist",
      "expect": ["json/missing-file"],
      "documents": { "analysis": "tests/fixtures/invalid/deliberately-absent.json" }
    },
    {
      "name": "analysis: unknown property, and required events missing",
      "expect": ["schema/invalid"],
      "documents": { "analysis": "tests/fixtures/invalid/analysis-schema-violation.json" }
    },
    {
      "name": "analysis: duplicate event id",
      "expect": ["analysis/duplicate-event-id"],
      "documents": { "analysis": "tests/fixtures/invalid/analysis-duplicate-event-id.json" }
    },
    {
      "name": "analysis: duplicate stem id",
      "expect": ["analysis/duplicate-stem-id"],
      "documents": { "analysis": "tests/fixtures/invalid/analysis-duplicate-stem-id.json" }
    },
    {
      "name": "analysis: event references an undeclared stem",
      "expect": ["analysis/unknown-stem-ref"],
      "documents": { "analysis": "tests/fixtures/invalid/analysis-unknown-stem-ref.json" }
    },
    {
      "name": "analysis: event ends before it starts",
      "expect": ["analysis/end-before-start"],
      "documents": { "analysis": "tests/fixtures/invalid/analysis-end-before-start.json" }
    },
    {
      "name": "analysis: durationSec disagrees with endSec - startSec",
      "expect": ["analysis/duration-mismatch"],
      "documents": { "analysis": "tests/fixtures/invalid/analysis-duration-mismatch.json" }
    },
    {
      "name": "analysis: beats out of order",
      "expect": ["analysis/beats-not-ascending"],
      "documents": { "analysis": "tests/fixtures/invalid/analysis-beats-not-ascending.json" }
    },
    {
      "name": "analysis: duplicate detector id",
      "expect": ["analysis/duplicate-detector-id"],
      "documents": { "analysis": "tests/fixtures/invalid/analysis-duplicate-detector-id.json" }
    },
    {
      "name": "analysis: event references an undeclared detector",
      "expect": ["analysis/unknown-detector-ref"],
      "documents": { "analysis": "tests/fixtures/invalid/analysis-unknown-detector-ref-event.json" }
    },
    {
      "name": "analysis: beat references an undeclared detector",
      "expect": ["analysis/unknown-detector-ref"],
      "documents": { "analysis": "tests/fixtures/invalid/analysis-unknown-detector-ref-beat.json" }
    },
    {
      "name": "analysis: endKind bounded without endSec",
      "expect": ["analysis/end-kind-mismatch"],
      "documents": { "analysis": "tests/fixtures/invalid/analysis-end-kind-bounded-without-end.json" }
    },
    {
      "name": "analysis: endKind instantaneous but endSec present",
      "expect": ["analysis/end-kind-mismatch"],
      "documents": { "analysis": "tests/fixtures/invalid/analysis-end-kind-instantaneous-with-end.json" }
    },
    {
      "name": "analysis: endKind unknown but endSec present",
      "expect": ["analysis/end-kind-mismatch"],
      "documents": { "analysis": "tests/fixtures/invalid/analysis-end-kind-unknown-with-end.json" }
    },
    {
      "name": "analysis: events out of order at an equal timestamp",
      "expect": ["analysis/events-not-ascending"],
      "documents": { "analysis": "tests/fixtures/invalid/analysis-events-not-ascending.json" }
    },
    {
      "name": "chart: lane outside the playfield",
      "expect": ["chart/lane-out-of-range"],
      "documents": { "chart": "tests/fixtures/invalid/chart-lane-out-of-range.json" }
    },
    {
      "name": "chart: endLane outside the playfield",
      "expect": ["chart/end-lane-out-of-range"],
      "documents": { "chart": "tests/fixtures/invalid/chart-end-lane-out-of-range.json" }
    },
    {
      "name": "chart: note ends before it starts",
      "expect": ["chart/end-not-after-start"],
      "documents": { "chart": "tests/fixtures/invalid/chart-end-not-after-start.json" }
    },
    {
      "name": "chart: hold without an end",
      "expect": ["chart/hold-missing-end"],
      "documents": { "chart": "tests/fixtures/invalid/chart-hold-missing-end.json" }
    },
    {
      "name": "chart: duplicate note id",
      "expect": ["chart/duplicate-note-id"],
      "documents": { "chart": "tests/fixtures/invalid/chart-duplicate-note-id.json" }
    },
    {
      "name": "chart: notes out of order",
      "expect": ["chart/notes-not-ascending"],
      "documents": { "chart": "tests/fixtures/invalid/chart-notes-not-ascending.json" }
    },
    {
      "name": "chart: bpmChanges out of order",
      "expect": ["chart/bpm-changes-not-ascending"],
      "documents": { "chart": "tests/fixtures/invalid/chart-bpm-changes-not-ascending.json" }
    },
    {
      "name": "cross: sourceEventId does not resolve in the paired analysis",
      "expect": ["cross/unknown-source-event"],
      "documents": {
        "analysis": "examples/analysis.example.json",
        "chart": "tests/fixtures/invalid/chart-unknown-source-event.json"
      }
    },
    {
      "name": "project: referenced document does not exist",
      "expect": ["project/missing-reference"],
      "documents": { "project": "tests/fixtures/invalid/project-missing-reference.json" }
    },
    {
      "name": "project: document reference is neither a file nor inline",
      "expect": ["schema/invalid"],
      "documents": { "project": "tests/fixtures/invalid/project-ambiguous-document-ref.json" }
    },
    {
      "name": "project: project and analysis point at different audio",
      "expect": ["cross/audio-mismatch"],
      "documents": { "project": "tests/fixtures/invalid/project-audio-mismatch.json" }
    },
    {
      "name": "project: project and analysis disagree on audio duration",
      "expect": ["cross/audio-duration-mismatch"],
      "documents": { "project": "tests/fixtures/invalid/project-audio-duration-mismatch.json" }
    },
    {
      "name": "project: project and inline analysis disagree on the audio hash",
      "expect": ["cross/audio-sha256-mismatch"],
      "documents": { "project": "tests/fixtures/invalid/project-audio-sha256-mismatch.json" }
    },
    {
      "name": "chart: waypoints on a note that does not travel",
      "expect": ["chart/waypoints-not-on-slide"],
      "documents": { "chart": "tests/fixtures/invalid/chart-waypoints-not-on-slide.json" }
    },
    {
      "name": "chart: slide has waypoints but no end",
      "expect": ["chart/waypoints-without-end"],
      "documents": { "chart": "tests/fixtures/invalid/chart-waypoints-without-end.json" }
    },
    {
      "name": "chart: slide waypoint outside the playfield",
      "expect": ["chart/waypoint-lane-out-of-range"],
      "documents": { "chart": "tests/fixtures/invalid/chart-waypoint-lane-out-of-range.json" }
    },
    {
      "name": "chart: slide points do not ascend in time",
      "expect": ["chart/waypoints-not-ascending"],
      "documents": { "chart": "tests/fixtures/invalid/chart-waypoints-not-ascending.json" }
    },
    {
      "name": "chart: endAction on a kind that has no end",
      "expect": ["chart/end-action-wrong-kind"],
      "documents": { "chart": "tests/fixtures/invalid/chart-end-action-wrong-kind.json" }
    },
    {
      "name": "chart: endAction on a note with no end",
      "expect": ["chart/end-action-without-end"],
      "documents": { "chart": "tests/fixtures/invalid/chart-end-action-without-end.json" }
    },
    {
      "name": "chart: flick endAction with no direction",
      "expect": ["chart/end-action-flick-without-direction"],
      "documents": { "chart": "tests/fixtures/invalid/chart-end-action-flick-without-direction.json" }
    },
    {
      "name": "chart: connection names a note that is not there",
      "expect": ["chart/connection-unknown-note"],
      "documents": { "chart": "tests/fixtures/invalid/chart-connection-unknown-note.json" }
    },
    {
      "name": "chart: connection joins a note to itself",
      "expect": ["chart/connection-self"],
      "documents": { "chart": "tests/fixtures/invalid/chart-connection-self.json" }
    },
    {
      "name": "chart: flick connection joins something that is not a flick",
      "expect": ["chart/connection-endpoint-kind"],
      "documents": { "chart": "tests/fixtures/invalid/chart-connection-endpoint-kind.json" }
    },
    {
      "name": "chart: connection runs backwards in time",
      "expect": ["chart/connection-not-forward"],
      "documents": { "chart": "tests/fixtures/invalid/chart-connection-not-forward.json" }
    },
    {
      "name": "chart: the same two notes are connected twice",
      "expect": ["chart/connection-duplicate", "chart/connection-branches"],
      "documents": { "chart": "tests/fixtures/invalid/chart-connection-duplicate.json" }
    },
    {
      "name": "chart: a note is connected onwards twice",
      "expect": ["chart/connection-branches"],
      "documents": { "chart": "tests/fixtures/invalid/chart-connection-branches.json" }
    },
    {
      "name": "chart: two decorations share an id",
      "expect": ["chart/duplicate-decoration-id"],
      "documents": { "chart": "tests/fixtures/invalid/chart-duplicate-decoration-id.json" }
    },
    {
      "name": "chart: a decoration ends when it starts",
      "expect": ["chart/decoration-end-not-after-start"],
      "documents": { "chart": "tests/fixtures/invalid/chart-decoration-end-not-after-start.json" }
    },
    {
      "name": "chart: a text decoration has no text",
      "expect": ["chart/text-decoration-missing-text"],
      "documents": { "chart": "tests/fixtures/invalid/chart-text-decoration-missing-text.json" }
    },
    {
      "name": "chart: decorations are out of order",
      "expect": ["chart/decorations-not-ascending"],
      "documents": { "chart": "tests/fixtures/invalid/chart-decorations-not-ascending.json" }
    },
    {
      "name": "chart: a decoration sits outside the playfield",
      "expect": ["schema/invalid"],
      "documents": { "chart": "tests/fixtures/invalid/chart-decoration-position-out-of-range.json" }
    },
    {
      "name": "chart: a decoration is more than fully opaque",
      "expect": ["schema/invalid"],
      "documents": { "chart": "tests/fixtures/invalid/chart-decoration-opacity-out-of-range.json" }
    },
    {
      "name": "chart: a decoration asks for an animation this version does not define",
      "expect": ["schema/invalid"],
      "documents": { "chart": "tests/fixtures/invalid/chart-decoration-unknown-animation.json" }
    },
    {
      "name": "chart: a decoration carries a field the contract does not define",
      "expect": ["schema/invalid"],
      "documents": { "chart": "tests/fixtures/invalid/chart-decoration-unknown-field.json" }
    },
    {
      "name": "chart: no decorations at all, as in every chart written before them",
      "expect": [],
      "documents": { "chart": "tests/fixtures/valid/chart-no-decorations.json" }
    },
    {
      "name": "chart: the decoration list is present and empty",
      "expect": [],
      "documents": { "chart": "tests/fixtures/valid/chart-decorations-empty.json" }
    },
    {
      "name": "chart: the least a text decoration may say",
      "expect": [],
      "documents": { "chart": "tests/fixtures/valid/chart-decoration-minimal.json" }
    },
    {
      "name": "chart: every field a text decoration may say",
      "expect": [],
      "documents": { "chart": "tests/fixtures/valid/chart-decoration-full.json" }
    },
    {
      "name": "chart: a decoration kind this version has never heard of",
      "expect": [],
      "documents": { "chart": "tests/fixtures/valid/chart-decoration-unknown-kind.json" }
    }
  ]
}
